# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO PARA DOCKER / PRODUCCIÓN
# Copiar este archivo a `docker/.env.production`:
#   cp docker/.env.production.example docker/.env.production
# ==============================================================================

# --- Configuración del Servidor y GraphDB ---
PORT=3000
GRAPHDB_URL=http://graphdb:7200
GRAPHDB_REPOSITORY=researcherDB
GRAPHDB_USER=dtorres
GRAPHDB_PASSWORD=cambiar_por_password_seguro

# --- Credenciales Iniciales de SuperAdmin ---
SUPERADMIN_EMAIL=admin@cientopolis.org
SUPERADMIN_PASSWORD=cambiar_por_password_admin_seguro

# --- Configuración de Firebase (Backend + Frontend Build) ---
FIREBASE_PROJECT_ID=tu-proyecto-firebase
VITE_FIREBASE_API_KEY=AIzaSyTuApiKeyDeFirebase
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto-firebase.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-firebase
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto-firebase.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_USE_FIREBASE_EMULATOR=false
